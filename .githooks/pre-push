#!/bin/sh

blocked=0

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "ERROR: Direct pushes to remote main are prohibited." >&2
    echo "Push a feature branch instead: git push -u origin feature/<short-description>" >&2
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi

exit 0

